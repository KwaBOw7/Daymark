{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": ".core-build",
    "lib": ["ES2022", "DOM"],
    "types": []
  },
  "include": ["src/domain/**/*.ts"]
}
