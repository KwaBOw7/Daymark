{
  "name": "daymark",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:core",
    "test:watch": "vitest",
    "test:core": "tsc -p tsconfig.coretest.json && node -e \"require('fs').writeFileSync('.core-build/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\" && node --test tests/core.test.cjs",
    "cap:init:android": "cap add android",
    "cap:init:ios": "cap add ios",
    "cap:sync:android": "npm run build && cap sync android && node scripts/patch-native-platforms.mjs android",
    "cap:sync:ios": "npm run build && cap sync ios && node scripts/patch-native-platforms.mjs ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.1",
    "vitest": "^5.0.4",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/android": "^8.5.3",
    "@capacitor/ios": "^8.5.3"
  },
  "engines": {
    "node": ">=22"
  }
}
